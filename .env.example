# Prisma CLI (migrations, db push) — uses mysql:// scheme
DATABASE_URL="mysql://docplanner:docplanner@localhost:3306/docplanner"

# Runtime adapter (PrismaMariaDb) — uses mariadb:// scheme
MARIADB_URL="mariadb://docplanner:docplanner@localhost:3306/docplanner"

# Optional: OpenAI API key for AI-powered chat search
# Without it, chat search falls back to keyword-based parsing
OPENAI_API_KEY=""
